{
	"name": "pi-extension-bash-guard",
	"version": "0.1.0",
	"description": "pi extension: guards large bash/powershell output, returns only a few key lines plus a rewrite hint, and injects output discipline at session start.",
	"main": "src/index.ts",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"bash",
		"guard",
		"truncate",
		"coding-agent",
		"ai",
		"llm"
	],
	"license": "MIT",
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/node": "^22.20.3",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	},
	"scripts": {
		"format": "biome format --write .",
		"lint": "biome lint .",
		"check:biome": "biome check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"type": "commonjs"
}
